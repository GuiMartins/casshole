<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Reintroduced on purpose for the IMAP email auto-fetch feature - a
      deliberate, user-approved reversal of the earlier "no network"
      decision (see CLAUDE.md). Used only for the user's own IMAP
      connection and for checking/downloading app updates from the
      project's GitHub Releases; no analytics/ads/telemetry.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Self-update from GitHub Releases (data/update/AppUpdateCoordinator). The app is
      side-loaded, so it installs its own new versions through PackageInstaller; the user
      still has to allow "install unknown apps" for Casshole once (system setting).
      UPDATE_PACKAGES_WITHOUT_USER_ACTION lets Android 12+ skip the confirmation dialog
      for a self-update after that.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:name=".CassholeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Casshole">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Casshole">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Share-to-import. application/pdf alone isn't enough: invoices that arrive by
              e-mail are often attached as application/octet-stream (or the legacy
              application/x-pdf), and the sharing app passes that type along unchanged -
              Casshole then never showed up in the share sheet. The content is checked for
              the PDF header before importing (UploadViewModel).
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-pdf" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!--
          Hands the exported summary PDF to another app (share sheet) without
          exposing the cache directory - only res/xml/file_paths.xml's export
          folder is reachable.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".data.update.UpdateInstallReceiver"
            android:exported="false" />

        <!--
          Required for AppCompatDelegate.setApplicationLocales() to sync with
          the platform LocaleManager on API 33+ (and to persist the choice
          via AppCompat's own storage below that) - not added automatically
          just by depending on appcompat, must be declared explicitly.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
